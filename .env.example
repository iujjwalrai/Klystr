# Copy to .env and adjust. .env is git-ignored.

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Set DB_ENGINE=sqlite to run without Postgres.
DB_ENGINE=postgres
POSTGRES_DB=klystr
POSTGRES_USER=klystr
POSTGRES_PASSWORD=klystr
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Broker / cache ---
REDIS_URL=redis://127.0.0.1:6379/0

# --- Control plane tuning ---
NODE_HEARTBEAT_TIMEOUT_SECONDS=40
AGENT_HEARTBEAT_INTERVAL_SECONDS=10
RECONCILE_INTERVAL_SECONDS=5
SCHEDULER_STRATEGY=least_loaded

# --- Logging ---
LOG_LEVEL=DEBUG
LOG_JSON=false

# --- CLI ---
KLYSTR_API_URL=http://127.0.0.1:8000/api/v1
